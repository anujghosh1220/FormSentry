import type { FieldValidation, FormField, FieldType } from '../types/form'

export interface ValidationResult {
  valid: boolean
  errors: string[]
}

const EMAIL_REGEX = /^[a-zA-Z0-9.!#$%&'*+/=?^_{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/

export function validateField(field: FormField, value: any): ValidationResult {
  const errors: string[] = []
  const validation = field.validation || {}
  const customMessage = validation.customMessage || {}

  const isEmpty = value === undefined || value === null || value === '' ||
    (Array.isArray(value) && value.length === 0) ||
    (typeof value === 'string' && value.trim() === '')

  if (validation.required || field.required) {
    if (isEmpty && field.type !== 'checkbox') {
      errors.push(customMessage.required || ${field.label} is required)
    }
    if (field.type === 'checkbox') {
      const boolValue = Boolean(value)
      if (!boolValue) {
        errors.push(customMessage.required || ${field.label} is required)
      }
    }
  }

  if (isEmpty && !(validation.required || field.required)) {
    return { valid: true, errors: [] }
  }

  if (field.type === 'email' && typeof value === 'string') {
    if (!EMAIL_REGEX.test(value.trim())) {
      errors.push(customMessage.email || 'Please enter a valid email address')
    }
  }

  if (field.type === 'text' || field.type === 'password' || field.type === 'textarea') {
    const strValue = String(value)
    if (validation.minLength !== undefined && strValue.length < validation.minLength) {
      errors.push(customMessage.minLength || ${field.label} must be at least  characters)
    }
    if (validation.maxLength !== undefined && strValue.length > validation.maxLength) {
      errors.push(customMessage.maxLength || ${field.label} must be at most  characters)
    }
    if (validation.pattern) {
      try {
        const regex = new RegExp(validation.pattern)
        if (!regex.test(strValue)) {
          errors.push(customMessage.pattern || 'Invalid format')
        }
      } catch (e) {
        // Skip invalid patterns
      }
    }
  }

  if (field.type === 'number') {
    const numValue = Number(value)
    if (Number.isNaN(numValue)) {
      errors.push('Please enter a valid number')
    } else {
      if (validation.min !== undefined && numValue < validation.min) {
        errors.push(customMessage.min || ${field.label} must be at least )
      }
      if (validation.max !== undefined && numValue > validation.max) {
        errors.push(customMessage.max || ${field.label} must be at most )
      }
    }
  }

  if (field.type === 'select' || field.type === 'radio') {
    if (value === '' || value === undefined || value === null) {
      errors.push(customMessage.invalidOption || 'Please select an option')
    }
  }

  if (field.type === 'date') {
    if (typeof value === 'string' && value !== '') {
      const dateValue = new Date(value + 'T00:00:00')
      if (validation.minDate) {
        const minDate = new Date(validation.minDate + 'T00:00:00')
        if (dateValue < minDate) {
          errors.push(customMessage.minDate || ${field.label} must be on or after )
        }
      }
      if (validation.maxDate) {
        const maxDate = new Date(validation.maxDate + 'T00:00:00')
        if (dateValue > maxDate) {
          errors.push(customMessage.maxDate || `${field.label} must be on or before ${validation.maxDate}`)
        }
      }
    }
  }

  return { valid: errors.length === 0, errors }
}

export function validateForm(fields: FormField[], values: Record<string, any>): { valid: boolean; errors: Record<string, string[]> } {
  const errors: Record<string, string[]> = {}
  let valid = true

  for (const field of fields) {
    const result = validateField(field, values[field.id])
    if (!result.valid) {
      errors[field.id] = result.errors
      valid = false
    }
  }

  return { valid, errors }
}

